# Public RPC URLs only. Credential-bearing URLs belong in a private environment.
UNICHAIN_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
REACTIVE_LASNA_RPC=

# Public signer addresses. Values used for constructor arguments and simulation only.
UNICHAIN_SIGNER=
BASE_SIGNER=
LASNA_SIGNER=

# Choose one secure signer source per network. Never put a private key in this file.
# Preferred: an encrypted Foundry keystore account in ~/.foundry/keystores.
UNICHAIN_KEYSTORE_ACCOUNT=
BASE_KEYSTORE_ACCOUNT=
LASNA_KEYSTORE_ACCOUNT=

# Alternative: an encrypted Foundry keystore file outside the repository.
UNICHAIN_KEYSTORE_PATH=
BASE_KEYSTORE_PATH=
LASNA_KEYSTORE_PATH=
